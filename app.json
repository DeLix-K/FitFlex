{
  "expo": {
    "name": "FitFlex",
    "slug": "FitFlex",
    "version": "1.0.0",
    "scheme": "fitflex",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teamk.fitflex",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fitflex.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FitFlex uses your photos to identify gym equipment from a picture.",
          "cameraPermission": "FitFlex uses your camera to identify gym equipment from a photo."
        }
      ],
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FitFlex uses your microphone to hear voice commands to your AI Coach.",
          "speechRecognitionPermission": "FitFlex uses speech recognition to turn your voice into text for your AI Coach."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "5d7afbfb-4304-4d69-907f-8184b8dd0872"
      }
    },
    "owner": "team_k"
  }
}
