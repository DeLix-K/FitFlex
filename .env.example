# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored — it will never be committed.

# Supabase (Dashboard > Project Settings > API)
# The anon key is safe to expose in the app; Row Level Security policies protect your data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (console.anthropic.com > API Keys)
# Do NOT prefix this with EXPO_PUBLIC_ — that would bundle it into the app and expose it
# to anyone who inspects the app's code. This key must only be used from a server-side
# context, e.g. a Supabase Edge Function, never called directly from the Expo app.
ANTHROPIC_API_KEY=

# USDA FoodData Central (fdc.nal.usda.gov/api-key-signup.html) — used for real nutrition data
EXPO_PUBLIC_USDA_API_KEY=

# Oura (cloud.ouraring.com > OAuth applications) — the client ID only; the client secret
# stays server-side as a Supabase Edge Function secret, never in this file
EXPO_PUBLIC_OURA_CLIENT_ID=

# ─────────────────────────────────────────────
# The following are NOT read from this .env file — they're server-side secrets
# configured in the Supabase Dashboard under Edge Functions > Secrets, listed
# here only so a fresh setup knows what to add:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID
#   OURA_CLIENT_ID, OURA_CLIENT_SECRET
#   PRINTFUL_API_TOKEN, PRINTFUL_STORE_ID (optional)
#   ALLOWED_ORIGINS — comma-separated list of origins allowed to call the
#     Edge Functions from a browser (e.g. "https://app.fitflex.com"). Local
#     dev (localhost/127.0.0.1, any port) is always allowed regardless of
#     this value. Every Edge Function reflects only an allowed Origin back
#     in its CORS header instead of "*" — set this to your real deployed
#     domain(s) before/after going live, or browser calls from that domain
#     will be blocked (server-to-server calls, e.g. via curl, are unaffected —
#     this only restricts which websites a browser will let call the function
#     on a signed-in user's behalf).
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided
# automatically to Edge Functions by Supabase and don't need to be set manually.
# ─────────────────────────────────────────────
